# Server Port (Apsara Hosting / Pterodactyl uses SERVER_PORT automatically)
PORT=3000

# Admin Console IP access:
# Set ADMIN_ALLOWED_IPS=* on cloud hosting (protected by Admin Password + 2FA + Lockout)
# or restrict to your public IP / CIDR, e.g. 203.144.x.x,192.168.100.0/24
ADMIN_ALLOWED_IPS=*

# Store integrations (can also be configured inside /admin -> Settings)
TELEGRAM_BOT_TOKEN=
KHQRPAY_API_KEY=
SMTP_EMAIL=
SMTP_PASSWORD=
