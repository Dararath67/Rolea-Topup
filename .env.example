# Server Port (Apsara Hosting / Pterodactyl uses SERVER_PORT automatically)
PORT=3000

# Admin Console Home WiFi IP restriction (comma-separated IPs/CIDRs; update if your Home ISP rotates IP)
ADMIN_ALLOWED_IPS=202.56.3.46

# Optional MySQL persistence (Apsara Hosting Database)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Store integrations (can also be configured inside /admin -> Settings)
TELEGRAM_BOT_TOKEN=
KHQRPAY_API_KEY=
SMTP_EMAIL=
SMTP_PASSWORD=
