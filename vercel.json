{
  "framework": null,
  "trailingSlash": false,
  "buildCommand": "rm -rf dist && mkdir -p dist && cp -r public/. dist/ && rm -f dist/admin.html dist/admin_login.html",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "http://51.81.90.228:35507/api/$1" },
    { "source": "/media/(.*)", "destination": "http://51.81.90.228:35507/media/$1" },
    { "source": "/admin", "destination": "http://51.81.90.228:35507/admin" },
    { "source": "/admin/(.*)", "destination": "http://51.81.90.228:35507/admin/$1" },
    { "source": "/admin.html", "destination": "http://51.81.90.228:35507/admin" },
    { "source": "/admin_login.html", "destination": "http://51.81.90.228:35507/admin/login" },
    { "source": "/games", "destination": "/games.html" },
    { "source": "/minigames", "destination": "/games.html" },
    { "source": "/game/(.*)", "destination": "/roblox.html" },
    { "source": "/spin", "destination": "/spin.html" },
    { "source": "/scratch", "destination": "/scratch.html" },
    { "source": "/box", "destination": "/box.html" },
    { "source": "/cases", "destination": "/box.html" },
    { "source": "/crash", "destination": "/crash.html" },
    { "source": "/rocket", "destination": "/crash.html" },
    { "source": "/check-order", "destination": "/check_order.html" },
    { "source": "/my-account", "destination": "/my_account.html" },
    { "source": "/profile", "destination": "/my_account.html" },
    { "source": "/signin", "destination": "/signin.html" },
    { "source": "/login", "destination": "/signin.html" },
    { "source": "/register", "destination": "/signin.html" },
    { "source": "/order/success/(.*)", "destination": "/receipt.html" }
  ]
}
